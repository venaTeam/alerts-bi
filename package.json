{
  "name": "alerts-bi",
  "version": "0.1.0",
  "private": true,
  "description": "Alerts BI — single-team weekly alert quality and migration scorecard",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "alerts-bi": "./src/cli.js"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/unit/*.test.js",
    "test:unit": "node --test --test-concurrency=1 test/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js",
    "test:acceptance": "node --test --test-concurrency=1 test/acceptance/*.test.js",
    "test:all": "node --test --test-concurrency=1 test/unit/*.test.js test/integration/*.test.js test/acceptance/*.test.js",
    "db:migrate": "node src/cli.js db migrate",
    "db:status": "node src/cli.js db status",
    "db:reset-test": "node src/cli.js db reset-test",
    "run:team": "node src/cli.js run",
    "mock:seed": "node scripts/generate-mock-alerts.mjs",
    "mock:stats": "node scripts/generate-mock-alerts.mjs --stats-only",
    "verify:acceptance": "node src/cli.js verify-acceptance"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "mssql": "11.0.1",
    "openai": "4.104.0"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/node": "^22.15.30",
    "eslint": "9.34.0",
    "globals": "15.15.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  }
}
